---
export interface Props {
  propertyId: string;
  name: string;
  location: string;
  type: string;
  price: string;
  specs: string[];
}

const { propertyId, name, location, type, price, specs } = Astro.props;
const BASE = `${import.meta.env.BASE_URL}/images/propiedades/${propertyId}`;
---

<div id={`gallery-${propertyId}`} class="gallery-modal fixed inset-0 z-[100] bg-black/80 hidden items-center justify-center p-4">
  <div class="relative bg-white w-full max-w-5xl max-h-[90vh] flex flex-col overflow-hidden animate-fade-in">

    <button class="gallery-close absolute top-3 right-3 z-20 w-8 h-8 bg-black/20 hover:bg-black/40 text-white flex items-center justify-center transition-colors rounded-full">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <div class="relative flex-1 bg-black flex items-center justify-center min-h-0">
      <button class="gallery-prev absolute left-2 top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-colors rounded-full">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <button class="gallery-next absolute right-2 top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-colors rounded-full">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>

      <div class="gallery-counter absolute top-3 left-3 z-10 bg-black/40 text-white text-xs px-2 py-1 rounded"></div>

      <div class="w-full h-full flex items-center justify-center p-8">
        <img class="gallery-image max-w-full max-h-full object-contain select-none" alt="" />
      </div>
    </div>

    <div class="bg-white px-6 py-4 border-t border-gray-200">
      <div class="flex items-start justify-between mb-1">
        <div>
          <span class="text-[10px] bg-gold text-white px-2 py-0.5 font-semibold uppercase tracking-wider mr-2">{type}</span>
          <h3 class="inline text-lg font-bold text-dark">{name}</h3>
        </div>
        <span class="text-gold text-sm font-bold whitespace-nowrap ml-4">{price}</span>
      </div>
      <p class="text-gray-400 text-xs mb-2">{location}</p>
      <div class="flex flex-wrap gap-2">
        {specs.map((spec) => (
          <span class="text-[10px] bg-gray-100 text-gray-500 px-2 py-0.5">{spec}</span>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .animate-fade-in {
    animation: fadeIn 0.2s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
</style>

<script>
  class Gallery {
    constructor(propertyId, images, options = {}) {
      this.id = propertyId;
      this.images = images;
      this.current = 0;
      this.container = document.getElementById(`gallery-${propertyId}`);
      this.img = this.container.querySelector('.gallery-image');
      this.counter = this.container.querySelector('.gallery-counter');
      this.closeBtn = this.container.querySelector('.gallery-close');
      this.prevBtn = this.container.querySelector('.gallery-prev');
      this.nextBtn = this.container.querySelector('.gallery-next');
      this.touchStartX = 0;
      this.touchEndX = 0;
      this.open = false;

      this.bindEvents();
    }

    bindEvents() {
      this.closeBtn.addEventListener('click', () => this.hide());
      this.prevBtn.addEventListener('click', () => this.prev());
      this.nextBtn.addEventListener('click', () => this.next());

      this.container.addEventListener('click', (e) => {
        if (e.target === this.container) this.hide();
      });

      document.addEventListener('keydown', (e) => {
        if (!this.open) return;
        if (e.key === 'Escape') this.hide();
        if (e.key === 'ArrowLeft') this.prev();
        if (e.key === 'ArrowRight') this.next();
      });

      this.container.addEventListener('touchstart', (e) => {
        this.touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      this.container.addEventListener('touchend', (e) => {
        this.touchEndX = e.changedTouches[0].screenX;
        const diff = this.touchStartX - this.touchEndX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) this.next();
          else this.prev();
        }
      }, { passive: true });
    }

    show(index = 0) {
      this.current = index;
      this.open = true;
      this.container.classList.remove('hidden');
      this.container.classList.add('flex');
      document.body.style.overflow = 'hidden';
      this.render();
    }

    hide() {
      this.open = false;
      this.container.classList.add('hidden');
      this.container.classList.remove('flex');
      document.body.style.overflow = '';
    }

    prev() {
      this.current = (this.current - 1 + this.images.length) % this.images.length;
      this.render();
    }

    next() {
      this.current = (this.current + 1) % this.images.length;
      this.render();
    }

    render() {
      const base = `${import.meta.env.BASE_URL}/images/propiedades/${this.id}`;
      const filename = encodeURIComponent(this.images[this.current]);
      this.img.src = `${base}/${filename}`;
      this.counter.textContent = `${this.current + 1} / ${this.images.length}`;
    }
  }

  window.Gallery = Gallery;
</script>