---
export interface Props {
  propertyId: string;
}

const { propertyId } = Astro.props;

const BASE = `${import.meta.env.BASE_URL}/images/propiedades/${propertyId}`;
---

<div id={`gallery-${propertyId}`} class="gallery-modal fixed inset-0 z-[100] bg-black/95 hidden items-center justify-center">
  <button class="gallery-close absolute top-4 right-4 z-10 w-10 h-10 bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>

  <button class="gallery-prev absolute left-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
  </button>

  <button class="gallery-next absolute right-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
  </button>

  <div class="gallery-counter absolute bottom-6 left-1/2 -translate-x-1/2 z-10 text-white/60 text-xs tracking-wider"></div>

  <div class="gallery-image-container w-full h-full flex items-center justify-center p-4">
    <img class="gallery-image max-w-full max-h-full object-contain select-none" alt="" />
  </div>
</div>

<script>
  class Gallery {
    constructor(propertyId, images) {
      this.id = propertyId;
      this.images = images;
      this.current = 0;
      this.container = document.getElementById(`gallery-${propertyId}`);
      this.img = this.container.querySelector('.gallery-image');
      this.counter = this.container.querySelector('.gallery-counter');
      this.closeBtn = this.container.querySelector('.gallery-close');
      this.prevBtn = this.container.querySelector('.gallery-prev');
      this.nextBtn = this.container.querySelector('.gallery-next');
      this.touchStartX = 0;
      this.touchEndX = 0;
      this.open = false;

      this.bindEvents();
    }

    bindEvents() {
      this.closeBtn.addEventListener('click', () => this.hide());
      this.prevBtn.addEventListener('click', () => this.prev());
      this.nextBtn.addEventListener('click', () => this.next());

      this.container.addEventListener('click', (e) => {
        if (e.target === this.container) this.hide();
      });

      document.addEventListener('keydown', (e) => {
        if (!this.open) return;
        if (e.key === 'Escape') this.hide();
        if (e.key === 'ArrowLeft') this.prev();
        if (e.key === 'ArrowRight') this.next();
      });

      this.container.addEventListener('touchstart', (e) => {
        this.touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      this.container.addEventListener('touchend', (e) => {
        this.touchEndX = e.changedTouches[0].screenX;
        const diff = this.touchStartX - this.touchEndX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) this.next();
          else this.prev();
        }
      }, { passive: true });
    }

    show(index = 0) {
      this.current = index;
      this.open = true;
      this.container.classList.remove('hidden');
      this.container.classList.add('flex');
      document.body.style.overflow = 'hidden';
      this.render();
    }

    hide() {
      this.open = false;
      this.container.classList.add('hidden');
      this.container.classList.remove('flex');
      document.body.style.overflow = '';
    }

    prev() {
      this.current = (this.current - 1 + this.images.length) % this.images.length;
      this.render();
    }

    next() {
      this.current = (this.current + 1) % this.images.length;
      this.render();
    }

    render() {
      const base = `${import.meta.env.BASE_URL}/images/propiedades/${this.id}`;
      const filename = encodeURIComponent(this.images[this.current]);
      this.img.src = `${base}/${filename}`;
      this.counter.textContent = `${this.current + 1} / ${this.images.length}`;
    }
  }

  window.Gallery = Gallery;
</script>
