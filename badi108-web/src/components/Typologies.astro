---
import PropertyGallery from './PropertyGallery.astro';
import fs from 'fs';
import path from 'path';

const IMAGE_BASE = path.join(process.cwd(), 'public', 'images', 'propiedades');
const URL_BASE = `${import.meta.env.BASE_URL}/images/propiedades`;

function getImages(folder) {
  const dir = path.join(IMAGE_BASE, folder);
  if (!fs.existsSync(dir)) return [];
  return fs.readdirSync(dir)
    .filter(f => /\.(jpg|jpeg|png|webp)$/i.test(f))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
}

const properties = [
  {
    id: 'aldama',
    name: 'ALDAMA',
    location: 'Hidalgo 24-D',
    type: 'Departamento',
    price: 'Desde $2,850,000',
    specs: ['Sala Comedor', 'Cocina', 'Terraza', 'Lavado'],
    thumb: `${URL_BASE}/aldama/IMAGEN 1.jpeg`,
  },
  {
    id: 'guadiana',
    name: 'GUADIANA',
    location: 'Insurgentes 9-A',
    type: 'Departamento',
    price: 'Desde $2,650,000',
    specs: ['3 Recámaras', '2 Baños', 'Balcón', 'Estacionamiento'],
    thumb: `${URL_BASE}/guadiana/IMAGEN 1.jpeg`,
  },
  {
    id: 'recreo',
    name: 'RECREO',
    location: 'Insurgentes 10-D',
    type: 'Departamento',
    price: 'Desde $3,150,000',
    specs: ['Sala Comedor', 'Cocina Integral', 'Roof Garden', 'Lavadero'],
    thumb: `${URL_BASE}/recreo/00.jpeg`,
  },
  {
    id: 'santo-domingo',
    name: 'SANTO DOMINGO',
    location: 'Insurgentes 6-D',
    type: 'Pent House',
    price: 'Desde $4,200,000',
    specs: ['4 Recámaras', '4 Baños', 'Roof Garden', 'Terraza'],
    thumb: `${URL_BASE}/santo-domingo/IMAGEN 07.jpeg`,
  },
  {
    id: 'zacateros',
    name: 'ZACATEROS',
    location: 'Relox 16-D',
    type: 'Departamento',
    price: 'Desde $2,950,000',
    specs: ['3 Recámaras', '3 Baños', 'Balcón', 'Estacionamiento'],
    thumb: `${URL_BASE}/zacateros/IMAGEN 1.jpeg`,
  },
];

const withImages = properties.map(p => ({
  ...p,
  images: getImages(p.id),
}));

const propertyImages = Object.fromEntries(
  withImages.map(p => [p.id, p.images])
);
---

<section id="propiedades" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-14 fade-in">
      <p class="text-gold text-sm tracking-[0.2em] uppercase mb-3">Oferta Inmobiliaria</p>
      <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4">Propiedades Disponibles</h2>
      <div class="w-14 h-0.5 bg-gold mx-auto mb-6"></div>
      <p class="text-gray-500 max-w-xl mx-auto text-sm leading-relaxed">
        Descubre nuestra selección de propiedades en San Miguel de Allende. Cada espacio ha sido diseñado para ofrecerte el confort y la calidad que mereces.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {withImages.map((prop) => (
        <div class="fade-in group cursor-pointer" data-property={prop.id}>
          <div class="relative h-64 overflow-hidden border border-gray-200">
            <img
              src={prop.thumb}
              alt={prop.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
            <div class="absolute top-3 left-3 bg-gold text-white text-[10px] px-3 py-1 font-semibold uppercase tracking-wider">
              {prop.type}
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-dark/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-4">
              <span class="text-white text-xs tracking-widest uppercase border border-white/40 px-4 py-2">
                Ver Galería
              </span>
            </div>
          </div>
          <div class="py-4 border-b border-gray-100">
            <div class="flex items-start justify-between mb-1">
              <h3 class="text-lg font-bold text-dark">{prop.name}</h3>
              <span class="text-gold text-sm font-bold">{prop.price}</span>
            </div>
            <p class="text-gray-400 text-xs mb-3">{prop.location}</p>
            <div class="flex flex-wrap gap-2">
              {prop.specs.map((spec) => (
                <span class="text-[10px] bg-gray-100 text-gray-500 px-2 py-0.5">{spec}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

{withImages.map((prop) => (
  <PropertyGallery propertyId={prop.id} />
))}

<script define:vars={{ propertyImages }}>
  const galleries = {};

  function initGallery(id, images) {
    if (!galleries[id]) {
      galleries[id] = new window.Gallery(id, images);
    }
  }

  Object.entries(propertyImages).forEach(([id, images]) => {
    if (images && images.length > 0) {
      initGallery(id, images);
    }
  });

  document.querySelectorAll('[data-property]').forEach(card => {
    const id = card.dataset.property;
    card.addEventListener('click', () => {
      const gallery = galleries[id];
      if (gallery) gallery.show(0);
    });
  });
</script>
