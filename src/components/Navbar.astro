---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const isHome = currentPath === base || currentPath === base + '/';
const p = (path: string) => `${base}${path}`;
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent">
  <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
    <a href={p('/')} class="flex items-center gap-3">
      <img src={p('/images/logo-badi108.webp')} alt="BADI 108" class="h-10 w-auto" />
      <div class="text-white">
        <span class="text-[9px] tracking-widest block font-light">Real Estate</span>
        <span class="text-sm font-bold tracking-wider">BADI 108</span>
      </div>
    </a>
    <div class="hidden md:flex items-center gap-6">
      <a href={p('/')} class="text-white/70 hover:text-gold transition-colors text-xs tracking-wide">Inicio</a>
      <a href={p('/nosotros')} class="text-white/70 hover:text-gold transition-colors text-xs tracking-wide">Nosotros</a>
      <a href={p('/propiedades')} class="text-white/70 hover:text-gold transition-colors text-xs tracking-wide">Propiedades</a>
      <a href={p('/rentas')} class="text-white/70 hover:text-gold transition-colors text-xs tracking-wide">Rentas</a>
      {isHome && <a href="#contacto" class="text-white/70 hover:text-gold transition-colors text-xs tracking-wide">Contacto</a>}
      {!isHome && <a href={p('/#contacto')} class="text-white/70 hover:text-gold transition-colors text-xs tracking-wide">Contacto</a>}
      <a href={p('/#contacto')} class="bg-gold hover:bg-gold-dark text-white px-5 py-2 text-xs tracking-widest uppercase transition-colors">
        Agenda tu Visita
      </a>
    </div>
    <button id="mobile-menu-btn" class="md:hidden text-white">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden md:hidden bg-primary/95 backdrop-blur-sm">
    <div class="px-6 py-3 flex flex-col gap-3">
      <a href={p('/')} class="text-white/70 hover:text-gold transition-colors text-xs">Inicio</a>
      <a href={p('/nosotros')} class="text-white/70 hover:text-gold transition-colors text-xs">Nosotros</a>
      <a href={p('/propiedades')} class="text-white/70 hover:text-gold transition-colors text-xs">Propiedades</a>
      <a href={p('/rentas')} class="text-white/70 hover:text-gold transition-colors text-xs">Rentas</a>
      {isHome && <a href="#contacto" class="text-white/70 hover:text-gold transition-colors text-xs">Contacto</a>}
      {!isHome && <a href={p('/#contacto')} class="text-white/70 hover:text-gold transition-colors text-xs">Contacto</a>}
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 100) {
      navbar?.classList.add('bg-primary/90', 'backdrop-blur-md');
      navbar?.classList.remove('bg-transparent');
    } else {
      navbar?.classList.remove('bg-primary/90', 'backdrop-blur-md');
      navbar?.classList.add('bg-transparent');
    }
  });

  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  document.querySelectorAll('#mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });
</script>
