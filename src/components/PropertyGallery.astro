---
export interface Props {
  propertyId: string;
  name: string;
  location: string;
  type: string;
  price: string;
}

const { propertyId, name, location, type, price } = Astro.props;
const BASE = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/images/propiedades/${propertyId}`;
---

<div id={`gallery-${propertyId}`} class="gallery-modal fixed inset-0 z-[100] bg-black/80 hidden items-center justify-center p-4">
  <div class="relative bg-white w-full max-w-5xl max-h-[90vh] flex flex-col overflow-hidden animate-fade-in">

    <button class="gallery-close absolute top-3 right-3 z-20 w-8 h-8 bg-black/20 hover:bg-black/40 text-white flex items-center justify-center transition-colors rounded-full">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <div class="relative flex-1 bg-black flex items-center justify-center min-h-0">
      <button class="gallery-prev absolute left-2 top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-colors rounded-full">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <button class="gallery-next absolute right-2 top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-colors rounded-full">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>

      <div class="gallery-counter absolute top-3 left-3 z-10 bg-black/40 text-white text-xs px-2 py-1 rounded"></div>

      <div class="w-full h-full flex items-center justify-center p-8">
        <img class="gallery-image max-w-full max-h-full object-contain select-none" alt="" />
      </div>
    </div>

    <div class="bg-white border-t border-gray-200 overflow-y-auto max-h-48">
      <div class="px-6 pt-4 pb-3">
        <div class="flex items-start justify-between mb-1">
          <div>
            <span class="text-[10px] bg-gold text-white px-2 py-0.5 font-semibold uppercase tracking-wider mr-2">{type}</span>
            <h3 class="inline text-lg font-bold text-dark">{name}</h3>
          </div>
          <span class="text-gold text-sm font-bold whitespace-nowrap ml-4">{price}</span>
        </div>
        <p class="text-gray-400 text-xs mb-3">{location}</p>

        <p class="text-xs text-gray-500 leading-relaxed mb-4">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.
        </p>

        <div class="grid grid-cols-3 gap-y-3 gap-x-2">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 8h16M4 8v6a2 2 0 002 2h12a2 2 0 002-2V8M4 8V6a2 2 0 012-2h12a2 2 0 012 2v2"/>
            </svg>
            <span class="text-[11px] text-gray-600">3 Baños</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="8" width="16" height="10" rx="1"/><line x1="4" y1="12" x2="20" y2="12"/><rect x="7" y="10" width="4" height="2" rx="0.5"/>
            </svg>
            <span class="text-[11px] text-gray-600">3 Recámaras</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 17v2a1 1 0 001 1h2a1 1 0 001-1v-1h6v1a1 1 0 001 1h2a1 1 0 001-1v-2M5 17l2-7h10l2 7M5 17h14"/><circle cx="7" cy="15" r="1.5"/><circle cx="17" cy="15" r="1.5"/>
            </svg>
            <span class="text-[11px] text-gray-600">Estacionamiento</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
            </svg>
            <span class="text-[11px] text-gray-600">Terraza</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 12c0-5 4-10 9-10s9 5 9 10M12 2v18M8 22h8"/>
            </svg>
            <span class="text-[11px] text-gray-600">Pérgola</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="10" width="20" height="12" rx="1"/><line x1="6" y1="10" x2="6" y2="6"/><line x1="18" y1="10" x2="18" y2="6"/><line x1="14" y1="10" x2="14" y2="6"/><line x1="10" y1="10" x2="10" y2="6"/>
            </svg>
            <span class="text-[11px] text-gray-600">Balcón</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 14h18v3a3 3 0 01-3 3H6a3 3 0 01-3-3v-3zM5 10V6a2 2 0 012-2h10a2 2 0 012 2v4"/><line x1="9" y1="2" x2="9" y2="4"/><line x1="15" y1="2" x2="15" y2="4"/>
            </svg>
            <span class="text-[11px] text-gray-600">Cocina Integral</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 10V7a2 2 0 012-2h12a2 2 0 012 2v3M4 10h16M4 10v4M20 10v4M4 14h16v3a2 2 0 01-2 2H6a2 2 0 01-2-2v-3z"/>
            </svg>
            <span class="text-[11px] text-gray-600">Sala Comedor</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="2" width="16" height="20" rx="2"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="2" x2="12" y2="4"/>
            </svg>
            <span class="text-[11px] text-gray-600">Lavadero</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22V12M12 12l-5 4M12 12l5 4M12 4L7 9M12 4l5 5"/><path d="M12 4a5 5 0 00-5 5h10a5 5 0 00-5-5z"/>
            </svg>
            <span class="text-[11px] text-gray-600">Roof Garden</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="6" width="20" height="12" rx="2"/><path d="M4 12c2-2 6-2 8 0s6 2 8 0M4 16c2-2 6-2 8 0s6 2 8 0"/>
            </svg>
            <span class="text-[11px] text-gray-600">Alberca</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="9" width="3" height="6" rx="1"/><rect x="19" y="9" width="3" height="6" rx="1"/><line x1="5" y1="12" x2="19" y2="12"/><rect x="7" y="10" width="2" height="4" rx="1"/><rect x="15" y="10" width="2" height="4" rx="1"/>
            </svg>
            <span class="text-[11px] text-gray-600">Gimnasio</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>
            </svg>
            <span class="text-[11px] text-gray-600">Seguridad 24h</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2C8 8 5 12 5 15a7 7 0 0014 0c0-3-3-7-7-13z"/>
            </svg>
            <span class="text-[11px] text-gray-600">Cisterna</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 8V6a3 3 0 013-3h6a3 3 0 013 3v2M6 8h12M6 8v8a2 2 0 002 2h8a2 2 0 002-2V8"/><line x1="12" y1="18" x2="12" y2="22"/>
            </svg>
            <span class="text-[11px] text-gray-600">Área de Lavado</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .animate-fade-in {
    animation: fadeIn 0.2s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
</style>

<script>
  class Gallery {
    constructor(propertyId, images, options = {}) {
      this.id = propertyId;
      this.images = images;
      this.current = 0;
      this.container = document.getElementById(`gallery-${propertyId}`);
      this.img = this.container.querySelector('.gallery-image');
      this.counter = this.container.querySelector('.gallery-counter');
      this.closeBtn = this.container.querySelector('.gallery-close');
      this.prevBtn = this.container.querySelector('.gallery-prev');
      this.nextBtn = this.container.querySelector('.gallery-next');
      this.touchStartX = 0;
      this.touchEndX = 0;
      this.open = false;

      this.bindEvents();
    }

    bindEvents() {
      this.closeBtn.addEventListener('click', () => this.hide());
      this.prevBtn.addEventListener('click', () => this.prev());
      this.nextBtn.addEventListener('click', () => this.next());

      this.container.addEventListener('click', (e) => {
        if (e.target === this.container) this.hide();
      });

      document.addEventListener('keydown', (e) => {
        if (!this.open) return;
        if (e.key === 'Escape') this.hide();
        if (e.key === 'ArrowLeft') this.prev();
        if (e.key === 'ArrowRight') this.next();
      });

      this.container.addEventListener('touchstart', (e) => {
        this.touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      this.container.addEventListener('touchend', (e) => {
        this.touchEndX = e.changedTouches[0].screenX;
        const diff = this.touchStartX - this.touchEndX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) this.next();
          else this.prev();
        }
      }, { passive: true });
    }

    show(index = 0) {
      this.current = index;
      this.open = true;
      this.container.classList.remove('hidden');
      this.container.classList.add('flex');
      document.body.style.overflow = 'hidden';
      this.render();
    }

    hide() {
      this.open = false;
      this.container.classList.add('hidden');
      this.container.classList.remove('flex');
      document.body.style.overflow = '';
    }

    prev() {
      this.current = (this.current - 1 + this.images.length) % this.images.length;
      this.render();
    }

    next() {
      this.current = (this.current + 1) % this.images.length;
      this.render();
    }

    render() {
      const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/images/propiedades/${this.id}`;
      const filename = encodeURIComponent(this.images[this.current]);
      this.img.src = `${base}/${filename}`;
      this.counter.textContent = `${this.current + 1} / ${this.images.length}`;
    }
  }

  window.Gallery = Gallery;
</script>