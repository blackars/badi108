---
const _base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const URL_BASE = `${_base}/images/propiedades`;
const PAGE_BASE = `${_base}/propiedades/la-serena`;

const properties = [
  {
    id: 'aldama',
    name: 'ALDAMA',
    location: 'Hidalgo 24-D',
    type: 'Departamento',
    price: 'Desde 4,271,000',
    specs: ['Sala Comedor', 'Cocina', 'Terraza', 'Lavado'],
    thumb: `${URL_BASE}/aldama/IMAGEN 1.webp`,
  },
  {
    id: 'guadiana',
    name: 'GUADIANA',
    location: 'Insurgentes 9-A',
    type: 'Departamento',
    price: 'Desde 6,360,000',
    specs: ['3 Recámaras', '2 Baños', 'Balcón', 'Estacionamiento'],
    thumb: `${URL_BASE}/guadiana/IMAGEN 1.webp`,
  },
  {
    id: 'recreo',
    name: 'RECREO',
    location: 'Insurgentes 10-D',
    type: 'Departamento',
    price: 'Desde 3,869,000',
    specs: ['Sala Comedor', 'Cocina Integral', 'Roof Garden', 'Lavadero'],
    thumb: `${URL_BASE}/recreo/00.webp`,
  },
  {
    id: 'santo-domingo',
    name: 'SANTO DOMINGO',
    location: 'San Miguel de Allende',
    type: 'Departamento',
    price: 'Desde 7,668,000',
    specs: ['3 Recámaras', '2 Baños', 'Terraza', 'Estacionamiento'],
    thumb: `${URL_BASE}/umaran/IMAGEN 1.webp`,
  },
  {
    id: 'zacateros',
    name: 'ZACATEROS',
    location: 'Relox 16-D',
    type: 'Departamento',
    price: 'Desde 5,300,000',
    specs: ['3 Recámaras', '3 Baños', 'Balcón', 'Estacionamiento'],
    thumb: `${URL_BASE}/zacateros/IMAGEN 1.webp`,
  },
];
---

<section id="propiedades" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-14 fade-in">
      <p class="text-gold text-sm tracking-[0.2em] uppercase mb-3">Diseñados para ti</p>
      <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4">Prototipos</h2>
      <div class="w-14 h-0.5 bg-gold mx-auto mb-6"></div>
      <p class="text-gray-500 max-w-xl mx-auto text-sm leading-relaxed">
        Detrás de la artesanía que tiene cada puerta, descubrirás prototipos diseñados para que tú y tu familia reciban la comodidad que se merecen
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {properties.map((prop) => (
        <div class="fade-in group">
          <a href={`${PAGE_BASE}/${prop.id}`} class="block relative h-64 overflow-hidden border border-gray-200">
            <img
              src={prop.thumb}
              alt={prop.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
            <div class="absolute top-3 left-3 bg-gold text-white text-[10px] px-3 py-1 font-semibold uppercase tracking-wider">
              {prop.type}
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-dark/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-4">
              <span class="text-white text-xs tracking-widest uppercase border border-white/40 px-4 py-2">
                Ver Galería
              </span>
            </div>
          </a>
          <div class="py-4 border-b border-gray-100">
            <div class="flex items-start justify-between mb-1">
              <h3 class="text-lg font-bold text-dark">{prop.name}</h3>
              <span class="text-gold text-sm font-bold">{prop.price}</span>
            </div>
            <p class="text-gray-400 text-xs mb-3">{prop.location}</p>
            <div class="flex flex-wrap gap-2">
              {prop.specs.map((spec) => (
                <span class="text-[10px] bg-gray-100 text-gray-500 px-2 py-0.5">{spec}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>


