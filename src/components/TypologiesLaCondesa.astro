    constM2: 265,
  },
  {
    id: 'san-leonel',
    name: 'SAN LEONEL',
    location: 'Privadas La Condesa',
    type: 'Casa',
    price: 'Desde $6,500,000',
    specs: ['3 Recámaras', '3 Baños', 'Cochera 2 Autos', 'Doble Altura'],
    thumb: `${URL_BASE}/san-leonel/DSC06927.webp`,
    constM2: 255,
  },
  {
    id: 'san-miguel',
    name: 'SAN MIGUEL',
    location: 'Privadas La Condesa',
    type: 'Casa',
    price: 'Desde $6,100,000',
    specs: ['3 Recámaras', '3 Baños', 'Cochera 2 Autos', 'Roof Garden'],
    thumb: `${URL_BASE}/san-miguel/La-Condesa-Modelos-Banner-San-Miguel.webp`,
    constM2: 233,
  },
  {
    id: 'san-pablo',
    name: 'SAN PABLO',
    location: 'Privadas La Condesa',
    type: 'Casa',
    price: 'Desde $6,298,000',
    specs: ['3 Recámaras', '3 Baños', 'Cochera 2 Autos', 'Roof Garden'],
    thumb: `${URL_BASE}/san-pablo/La-Condesa-Modelos-Banner-San-Pablo.webp`,
    constM2: 197,
  },
  {
    id: 'san-rafael',
    name: 'SAN RAFAEL',
    location: 'Privadas La Condesa',
    type: 'Casa',
    price: 'Desde $6,460,000',
    specs: ['3 Recámaras', '3 Baños', 'Cochera 2 Autos', 'Doble Altura'],
    thumb: `${URL_BASE}/san-rafael/La-Condesa-Modelos-Banner-San-Rafael.webp`,
    constM2: 252,
  },
  {
    id: 'lotes-residenciales',
    name: 'LOTES RESIDENCIALES',
    location: 'Privadas La Condesa',
    type: 'Terreno',
