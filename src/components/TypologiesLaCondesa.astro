    location: 'Privadas La Condesa',
    type: 'Casa',
    price: 'Desde $6,560,000',
    specs: ['4 Recámaras', '4 Baños', 'Cochera 2 Autos', 'Sala Comedor Doble Altura'],
    thumb: `${URL_BASE}/san-agustin/La-Condesa-Modelos-Banner-San-Agustin.webp`,
    constM2: 280,
  },
  {
    id: 'san-angel',
    name: 'SAN ÁNGEL',
    location: 'Privadas La Condesa',
    type: 'Casa',
    price: 'Desde $5,697,000',
    specs: ['2 Recámaras', '2 Baños', 'Cochera 2 Autos', 'Estudio'],
    thumb: `${URL_BASE}/san-angel/La-Condesa-Modelos-Banner-San-Angel.webp`,
    constM2: 159,
  },
  {
    id: 'san-gabriel',
    name: 'SAN GABRIEL',
    location: 'Privadas La Condesa',
    type: 'Casa',
