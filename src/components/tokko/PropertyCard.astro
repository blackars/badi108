---
interface Props {
  id: string | number;
  title: string;
  location: string;
  price: string;
  typeName: string;
  operationLabel: string;
  cover: string | null;
  specs: string[];
  href: string;
  badgeColor?: string;
}
const { id, title, location, price, typeName, operationLabel, cover, specs, href, badgeColor } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

---

<div class="fade-in group">
  <a href={href} class="block relative h-64 overflow-hidden border border-gray-200 hover:border-primary transition-colors">
    {cover ? (
      <img
        src={cover}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full bg-gray-100 flex items-center justify-center">
        <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
    )}
    <div class={`absolute top-3 left-3 text-white text-[10px] px-3 py-1 font-semibold uppercase tracking-wider ${badgeColor ?? 'bg-gold'}`}>
      {operationLabel}
    </div>
    <div class="absolute top-3 right-3 bg-black/60 text-white text-[10px] px-2 py-1 font-medium tracking-wider">
      {typeName}
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-dark/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-4">
      <span class="text-white text-xs tracking-widest uppercase border border-white/40 px-4 py-2">
        Ver Detalle
      </span>
    </div>
  </a>
  <div class="py-4 border-b border-gray-100">
    <div class="flex items-start justify-between mb-1 gap-3">
      <h3 class="text-sm md:text-base font-bold text-dark leading-tight line-clamp-2">{title}</h3>
      <span class="text-gold text-sm font-bold whitespace-nowrap">{price}</span>
    </div>
    <p class="text-gray-400 text-xs mb-3 line-clamp-1">{location}</p>
    <div class="flex flex-wrap gap-2">
      {specs.slice(0,4).map((spec) => (
        <span class="text-[10px] bg-gray-100 text-gray-500 px-2 py-0.5">{spec}</span>
      ))}
    </div>
  </div>
</div>
