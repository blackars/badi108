---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Layout title="Propiedades | BADI 108 Real Estate">
  <Navbar />
  <main>
    <section class="relative h-[40vh] min-h-[300px] overflow-hidden">
      <div class="absolute inset-0">
        <img src={base + '/images/hero-plaza.webp'} alt="Propiedades" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-primary/80 to-primary/90"></div>
      </div>
      <div class="relative z-10 h-full flex flex-col items-center justify-center text-center px-6">
        <h1 class="text-4xl md:text-6xl font-bold text-white">Nuestros Proyectos</h1>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-14 fade-in">
          <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4">Oferta Inmobiliaria</h2>
          <div class="w-14 h-0.5 bg-gold mx-auto mb-6"></div>
          <p class="text-gray-500 max-w-xl mx-auto text-sm leading-relaxed">
            Cada persona tiene una forma diferente de invertir y de vivir. Por eso, en BADI 108 Real Estate hemos seleccionado proyectos que responden a distintos objetivos: generar patrimonio, obtener plusvalía, disfrutar un retiro tranquilo o encontrar el lugar ideal para comenzar una nueva etapa.
          </p>
          <p class="text-gray-500 font-bold max-w-xl mx-auto text-sm leading-relaxed">
      Descubre las oportunidades que hoy tenemos disponibles en San Miguel de Allende y encuentra el proyecto que mejor se adapta a tus necesidades.          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
          <a href={base + '/propiedades/la-serena'} class="fade-in group block border border-gray-200 hover:border-primary transition-colors">
            <div class="relative h-64 overflow-hidden">
              <img src={base + '/images/prototipos.webp'} alt="La Serena Residencial" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
              <div class="absolute top-3 left-3 bg-gold text-white text-[10px] px-3 py-1 font-semibold uppercase tracking-wider">
                Ultimas Ubicaciones
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-dark/70 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4">
                <h3 class="text-xl font-bold text-white">La Serena Residencial</h3>
                <p class="text-white/60 text-xs">San Miguel de Allende, Gto.</p>
              </div>
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs text-gray-400">Departamentos 2, 3 y 4 Recámaras</span>
                <span class="text-primary text-xs font-bold tracking-wider">Ver Proyecto</span>
              </div>
              <div class="flex gap-2">
                <span class="text-[10px] bg-gray-100 text-gray-500 px-2 py-0.5">5 Tipologias</span>
                <span class="text-[10px] bg-gray-100 text-gray-500 px-2 py-0.5">Amenidades</span>
                <span class="text-[10px] bg-gray-100 text-gray-500 px-2 py-0.5">A 8 min Centro</span>
              </div>
            </div>
          </a>

          <a href={base + '/propiedades/la-condesa'} class="fade-in group block border border-gray-200 hover:border-primary transition-colors">
            <div class="relative h-64 overflow-hidden">
              <img src={base + '/images/propiedades/la-condesa/hd/La-Condesa-Para-Disfrutar-imagen-1.webp'} alt="Privadas La Condesa" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
              <div class="absolute top-3 left-3 bg-gold text-white text-[10px] px-3 py-1 font-semibold uppercase tracking-wider">
                Disponible
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-dark/70 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4">
                <h3 class="text-xl font-bold text-white">Privadas La Condesa</h3>
                <p class="text-white/60 text-xs">San Miguel de Allende, Gto.</p>
              </div>
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs text-gray-400">Casas | Terrenos</span>
                <span class="text-primary text-xs font-bold tracking-wider">Ver Proyecto</span>
              </div>
              <div class="flex gap-2">
                <span class="text-[10px] bg-gray-100 text-gray-500 px-2 py-0.5">8 Modelos</span>
                <span class="text-[10px] bg-gray-100 text-gray-500 px-2 py-0.5">Amenidades</span>
                <span class="text-[10px] bg-gray-100 text-gray-500 px-2 py-0.5">A 8 min Centro</span>
              </div>
            </div>
          </a>

          <a href={base + '/propiedades/santa-anita'} class="fade-in group block border border-gray-200 hover:border-primary transition-colors">
            <div class="relative h-64 overflow-hidden">
              <img src={base + '/images/propiedades/santa-anita/maincover.webp'} alt="Rancho Santa Anita de Jalpa" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
              <div class="absolute top-3 left-3 bg-gray-500 text-white text-[10px] px-3 py-1 font-semibold uppercase tracking-wider">
                Agotado
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-dark/70 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4">
                <h3 class="text-xl font-bold text-white">Rancho Santa Anita de Jalpa</h3>
                <p class="text-white/60 text-xs">La Purisima de Jalpa, Gto.</p>
              </div>
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs text-gray-400">Lotes Campestres Sustentables</span>
                <span class="text-primary text-xs font-bold tracking-wider">Ver Proyecto</span>
              </div>
              <div class="flex gap-2">
                <span class="text-[10px] bg-gray-100 text-gray-500 px-2 py-0.5">10 Lotes</span>
                <span class="text-[10px] bg-gray-100 text-gray-500 px-2 py-0.5">100% Vendido</span>
                <span class="text-[10px] bg-gray-100 text-gray-500 px-2 py-0.5">25 min SMA</span>
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
