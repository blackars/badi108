---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Typologies from '../../components/Typologies.astro';
import Amenities from '../../components/Amenities.astro';
import Footer from '../../components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Layout title="La Serena Residencial | BADI 108 Real Estate" theme="la-serena">
  <Navbar />
  <main>
    <section class="relative h-[50vh] min-h-[350px] overflow-hidden">
      <div class="absolute inset-0">
        <img src={`${base}/images/prototipos.webp`} alt="La Serena Residencial" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-primary/80 to-primary/90"></div>
      </div>
      <div class="relative z-10 h-full flex flex-col items-center justify-center text-center px-6">
        <p class="text-gold text-xs tracking-[0.3em] uppercase mb-3 font-light">San Miguel de Allende, Guanajuato</p>
        <p class="text-gold text-xs tracking-[0.3em] uppercase mb-3 font-light">PATRIMONIO CULTURAL DE LA HUMANIDAD 
        </p>

        <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-3">La Serena Residencial</h1>
        <p class="text-white/70 text-sm max-w-lg">Residencial premium que rinde homenaje al pintoresco pueblo mágico de San Miguel de Allende</p>
      </div>
    </section>

    <section class="py-14 bg-white border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div class="fade-in">
            <p class="text-gold text-sm tracking-[0.2em] uppercase mb-3">Sobre el Proyecto</p>
            <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4 leading-tight">
              Un Homenaje a<br/>San Miguel de Allende
            </h2>
            <div class="w-14 h-0.5 bg-gold mb-6"></div>
            <p class="text-gray-500 leading-relaxed mb-4 text-sm">
              San Miguel de Allende fue nombrada en el año 2021 la mejor ciudad del mundo por la revista Travel+Leisure. Es considerada Patrimonio de la Humanidad, ofreciendo un gran valor artístico, histórico, gastronómico y cultural.
            </p>
            <p class="text-gray-500 leading-relaxed mb-6 text-sm">
              Se ha convertido en el destino favorito del turismo, tanto extranjero como nacional, así como uno de los mejores lugares para vivir. La Serena Residencial honra esta belleza en cada espacio y rincón.
            </p>
            <div class="grid grid-cols-2 gap-4 max-w-sm">
              <div class="text-center p-4 border border-gray-100">
                <span class="text-2xl font-bold text-primary block">8</span>
                <span class="text-xs text-gray-400">Minutos del Centro</span>
              </div>
              <div class="text-center p-4 border border-gray-100">
                <span class="text-2xl font-bold text-primary block">2021</span>
                <span class="text-xs text-gray-400">Mejor Ciudad del Mundo</span>
              </div>
            </div>
          </div>
          <div class="fade-in">
            <img src={`${base}/images/san-miguel-church.webp`} alt="Parroquia San Miguel" class="w-full max-h-[450px] object-cover" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <section class="relative w-full" style="height: 70vh; min-height: 400px;">
      <video id="promo-video" class="w-full h-full object-cover" autoplay muted loop playsinline>
        <source src={`${base}/videos/la-serena-promo.mp4`} type="video/mp4" />
      </video>
      <button id="unmute-btn" class="absolute bottom-6 right-6 z-10 w-12 h-12 bg-black/50 hover:bg-black/70 text-white flex items-center justify-center transition-colors rounded-full backdrop-blur-sm" title="Activar sonido">
        <svg id="icon-muted" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
          <line x1="23" y1="9" x2="17" y2="15"/>
          <line x1="17" y1="9" x2="23" y2="15"/>
        </svg>
        <svg id="icon-unmuted" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
          <path d="M19.07 4.93a10 10 0 010 14.14M15.54 8.46a5 5 0 010 7.07"/>
        </svg>
      </button>
    </section>

    <Typologies />
    <Amenities />

    <section class="py-14 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div class="fade-in order-2 md:order-1">
            <div class="overflow-hidden">
              <img src={`${base}/images/ubicacion.webp`} alt="Ubicación La Serena" class="w-full h-[350px] object-cover" loading="lazy" />
            </div>
          </div>
          <div class="fade-in order-1 md:order-2">
            <p class="text-gold text-sm tracking-[0.2em] uppercase mb-3">Ubicación Privilegiada</p>
            <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4">A 8 Minutos del patrimonio cultural de la humanidad</h2>
            <div class="w-14 h-0.5 bg-gold mb-6"></div>
            <p class="text-gray-500 text-sm mb-6">
              Carretera San Miguel - Celaya 41, Fracc. Villa de Los Frailes, 37790, San Miguel de Allende, Gto.
            </p>
            <a href="https://maps.google.com" target="_blank" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white px-5 py-2.5 text-xs tracking-wide transition-colors">
              Ver en Google Maps
            </a>
            <div class="mt-6 grid grid-cols-2 gap-x-6 gap-y-2">
              <p class="text-gray-500 text-xs">Centro Histórico</p>
              <p class="text-gray-500 text-xs">El Mirador</p>
              <p class="text-gray-500 text-xs">Museo Casa Allende</p>
              <p class="text-gray-500 text-xs">Centro Cultural La Aurora</p>
              <p class="text-gray-500 text-xs">Mercado de Artesanías</p>
              <p class="text-gray-500 text-xs">Teatro Ángela Peralta</p>
              <p class="text-gray-500 text-xs">Centro Cultural Ignacio Ramírez</p>
              <p class="text-gray-500 text-xs">Club de Golf Malanquín</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="contacto-la-serena" class="py-20 overlay-primary section-bg" style="background-image: url('${base}/images/background1.webp')">
      <div class="relative z-10 max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12">
          <div class="fade-in">
            <p class="text-gold text-sm tracking-[0.2em] uppercase mb-3">La Serena Residencial</p>
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Agenda tu Visita</h2>
            <div class="w-14 h-0.5 bg-gold mb-6"></div>
            <p class="text-white/70 mb-8 text-sm leading-relaxed">
              Descubre todo lo que La Serena Residencial tiene para ti. Nuestro equipo estará encantado de atenderte.
            </p>

            <div class="space-y-5">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-white/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-white/50 text-xs">Teléfono</p>
                  <p class="text-white text-sm font-medium">55 2748 6478 / 56 2418 3152</p>
                </div>
              </div>

              <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-white/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-white/50 text-xs">Dirección</p>
                  <p class="text-white text-sm font-medium">Carretera San Miguel - Celaya 41</p>
                </div>
              </div>

              <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-white/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-white/50 text-xs">Email</p>
                  <p class="text-white text-sm font-medium">laura@badi108realestate.com</p>
                </div>
              </div>
            </div>
          </div>

          <div class="fade-in">
            <form class="bg-white p-7">
              <div class="mb-4">
                <label class="block text-xs font-medium text-dark mb-1.5">Nombre Completo</label>
                <input type="text" class="w-full px-3 py-2.5 border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm" placeholder="Tu nombre" />
              </div>
              <div class="mb-4">
                <label class="block text-xs font-medium text-dark mb-1.5">Email</label>
                <input type="email" class="w-full px-3 py-2.5 border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm" placeholder="tu@email.com" />
              </div>
              <div class="mb-4">
                <label class="block text-xs font-medium text-dark mb-1.5">Teléfono</label>
                <input type="tel" class="w-full px-3 py-2.5 border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm" placeholder="Tu teléfono" />
              </div>
              <div class="mb-5">
                <label class="block text-xs font-medium text-dark mb-1.5">¿Qué te interesa?</label>
                <select class="w-full px-3 py-2.5 border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm">
                  <option>Pent House</option>
                  <option>Casa</option>
                  <option>Departamento</option>
                  <option>Más información</option>
                </select>
              </div>
              <button type="submit" class="w-full bg-primary hover:bg-primary-dark text-white py-3 font-medium tracking-wide transition-all text-sm">
                Enviar Mensaje
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <section class="py-14 bg-white">
      <div class="max-w-7xl mx-auto px-6 text-center fade-in">
        <p class="text-gold text-sm tracking-[0.2em] uppercase mb-3">BADI 108</p>
        <h3 class="text-xl font-bold text-dark mb-3">Real Estate</h3>
        <p class="text-gray-500 text-sm max-w-lg mx-auto leading-relaxed">
          Te ayudamos a encontrar tu hogar ideal en San Miguel de Allende.
        </p>
        <p class="text-gray-500 text-sm max-w-lg mx-auto mt-2 leading-relaxed">
          La Serena Residencial, un homenaje a la belleza y tradición de este pueblo mágico.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const video = document.getElementById('promo-video');
  const btn = document.getElementById('unmute-btn');
  const iconMuted = document.getElementById('icon-muted');
  const iconUnmuted = document.getElementById('icon-unmuted');

  if (video && btn) {
    btn.addEventListener('click', () => {
      video.muted = !video.muted;
      iconMuted.classList.toggle('hidden');
      iconUnmuted.classList.toggle('hidden');
    });
  }
</script>
