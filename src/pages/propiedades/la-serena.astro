---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Typologies from '../../components/Typologies.astro';
import Amenities from '../../components/Amenities.astro';
import Footer from '../../components/Footer.astro';
import catalogo from '../../tabla_la_serena.json';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const catalogoData = catalogo.catalogoResidencias;
---

<Layout title="La Serena Residencial | BADI 108 Real Estate" theme="la-serena">
  <Navbar />
  <main>
    <section class="relative h-[50vh] min-h-[350px] overflow-hidden">
      <div class="absolute inset-0">
        <img src={`${base}/images/prototipos.webp`} alt="La Serena Residencial" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-primary/80 to-primary/90"></div>
      </div>
      <div class="relative z-10 h-full flex flex-col items-center justify-center text-center px-6">
        <p class="text-gold text-xs tracking-[0.3em] uppercase mb-3 font-light">San Miguel de Allende, Guanajuato</p>
        <p class="text-gold text-xs tracking-[0.3em] uppercase mb-3 font-light">PATRIMONIO CULTURAL DE LA HUMANIDAD 
        </p>

        <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-3">La Serena Residencial</h1>
        <p class="text-white/70 text-sm max-w-lg">Residencial premium que rinde homenaje al pintoresco pueblo mágico de San Miguel de Allende</p>
      </div>
    </section>

    <section class="py-14 bg-white border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div class="fade-in">
            <p class="text-gold text-sm tracking-[0.2em] uppercase mb-3">Patrimonio Cultural de la Humanidad
</p>
            <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4 leading-tight">
              Inspirado en la esencia de<br/>San Miguel de Allende
            </h2>
            <div class="w-14 h-0.5 bg-gold mb-6"></div>
            <p class="text-gray-500 leading-relaxed mb-4 text-sm">
Reconocida en múltiples ocasiones por Travel + Leisure como una de las mejores ciudades del mundo, San Miguel de Allende cautiva por su riqueza histórica, su arquitectura, su gastronomía y la calidad de vida que la convierten en un destino excepcional para vivir e invertir.
            </p>
            <p class="text-gray-500 leading-relaxed mb-6 text-sm">
Inspirado en el encanto y la autenticidad de esta ciudad Patrimonio Cultural de la Humanidad, La Serena Residencial ofrece una propuesta única donde la arquitectura contemporánea, las amenidades premium y la administración hotelera by Krystal Grand se integran para brindar una experiencia de vida extraordinaria.
            </p>
            <p class="text-gray-500 leading-relaxed mb-6 text-sm">
Cada espacio ha sido diseñado para disfrutar el confort, la tranquilidad y un servicio de primer nivel, permitiéndote vivir cada día con la experiencia y el cuidado que distinguen a un hotel de prestigio, sin dejar de sentirte en casa.
            </p>
            <div class="grid grid-cols-2 gap-4 max-w-sm">
              <div class="text-center p-4 border border-gray-100">
                <span class="text-2xl font-bold text-primary block">8</span>
                <span class="text-xs text-gray-400">Minutos del Centro</span>
              </div>
              <div class="text-center p-4 border border-gray-100">
                <span class="text-2xl font-bold text-primary block">2021</span>
                <span class="text-xs text-gray-400">Mejor Ciudad del Mundo</span>
              </div>
              <div class="col-span-1">
              </div>
            </div>
          </div>
          <div class="fade-in">
            <img src={`${base}/images/san-miguel-church.webp`} alt="Parroquia San Miguel" class="w-full max-h-[450px] object-cover" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <section class="py-10 bg-white border-b border-gray-100">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <p class="text-gold text-sm tracking-[0.2em] uppercase mb-3">La Serena Residencial</p>
        <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4 leading-tight">
Donde cada día se vive con la experiencia de un hotel de prestigio y la tranquilidad de estar en casa.
        </h2>
        <div class="w-14 h-0.5 bg-gold mx-auto mb-6"></div>
      </div>
    </section>

    <section class="relative w-full bg-black flex items-center justify-center" style="height: 75vh; min-height: 300px;">
      <video id="promo-video" class="w-full h-full object-contain" autoplay muted loop playsinline style="max-height: 75vh;">
        <source src={`${base}/videos/la-serena-promo.mp4`} type="video/mp4" />
      </video>
      <button id="unmute-btn" class="absolute bottom-6 right-6 z-10 w-12 h-12 bg-white/15 hover:bg-white/30 text-white flex items-center justify-center transition-colors rounded-full backdrop-blur-sm border border-white/20" title="Activar sonido">
        <svg id="icon-muted" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
          <line x1="23" y1="9" x2="17" y2="15"/>
          <line x1="17" y1="9" x2="23" y2="15"/>
        </svg>
        <svg id="icon-unmuted" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
          <path d="M19.07 4.93a10 10 0 010 14.14M15.54 8.46a5 5 0 010 7.07"/>
        </svg>
      </button>
    </section>

    <section class="py-16 bg-primary relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0" style={`background-image: url('${base}/images/background1.webp'); background-size: cover; background-position: center;`}></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
        <p class="text-gold text-xs tracking-[0.3em] uppercase mb-4 font-light">Oportunidad Limitada</p>
        <h2 class="text-3xl md:text-5xl font-bold text-white mb-6 leading-tight">
          20% de Descuento<br/>en Pago de Contado
        </h2>
        <div class="w-16 h-0.5 bg-gold mx-auto mb-8"></div>

        <div class="grid md:grid-cols-3 gap-6 mb-10">
          <div class="bg-white/10 backdrop-blur-sm p-6 border border-white/10">
            <span class="text-3xl font-bold text-gold block mb-2">20%</span>
            <p class="text-white/80 text-sm">Descuento pago de contado</p>
            <p class="text-white/50 text-xs mt-1">Sin banco</p>
          </div>
          <div class="bg-white/10 backdrop-blur-sm p-6 border border-white/10">
            <span class="text-3xl font-bold text-gold block mb-2">5-10%</span>
            <p class="text-white/80 text-sm">Descuento con crédito interno</p>
            <p class="text-white/50 text-xs mt-1">Desarrollador directo</p>
          </div>
          <div class="bg-white/10 backdrop-blur-sm p-6 border border-white/10">
            <span class="text-3xl font-bold text-gold block mb-2">8%</span>
            <p class="text-white/80 text-sm">Tasa de interés anual</p>
            <p class="text-white/50 text-xs mt-1">Financiamiento directo</p>
          </div>
        </div>

        <p class="text-white/70 text-sm max-w-2xl mx-auto mb-8 leading-relaxed">
          Descubre una de las últimas oportunidades para invertir en La Serena Residencial. Vive la experiencia de un desarrollo con administración hotelera by Krystal Grand, amenidades premium estilo resort y el estilo de vida que distingue a San Miguel de Allende.
        </p>

        <div class="text-white/60 text-[11px] md:text-xs leading-6 max-w-xl mx-auto mb-8 space-y-1">
          <p>Tasa de interés preferencial del 8.0% anual, antes 9.9% anual.</p>
          <p>Vigencia: Promoción válida hasta el 1 de agosto de 2026.</p>
          <p>* Consulta los modelos participantes.</p>
          <p>* Promoción sujeta a cambios sin previo aviso.</p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://wa.me/524151457780?text=Hola,%20me%20interesa%20La%20Serena%20Residencial.%20¿Podrían%20enviarme%20fotos%20de%20los%20modelos%20disponibles?" target="_blank" class="inline-flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white px-8 py-3.5 text-sm font-medium tracking-wide transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Solicitar Fotos por WhatsApp
          </a>
          <a href="#contacto-la-serena" class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/20 px-8 py-3.5 text-sm font-medium tracking-wide transition-colors">
            Agendar una Visita
          </a>
        </div>
      </div>
    </section>

    <Typologies />

    <section class="py-14 bg-gray-50">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-10 fade-in">
          <p class="text-gold text-sm tracking-[0.2em] uppercase mb-3">Catálogo de Prototipos</p>
          <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4">Elige tu Modelo Ideal</h2>
          <div class="w-14 h-0.5 bg-gold mx-auto mb-6"></div>
          <p class="text-gray-500 text-sm max-w-lg mx-auto">Cada prototipo ofrece diferentes variantes según el nivel. Explora las opciones disponibles.</p>
        </div>

        <div class="flex flex-wrap justify-center gap-3 mb-8 fade-in" id="filters">
          <button class="filter-btn active px-4 py-2 text-xs font-medium border border-primary text-primary hover:bg-primary hover:text-white transition-colors" data-filter="all">Todos</button>
          <button class="filter-btn px-4 py-2 text-xs font-medium border border-gray-300 text-gray-500 hover:border-primary hover:text-primary transition-colors" data-filter="2">2 Recámaras</button>
          <button class="filter-btn px-4 py-2 text-xs font-medium border border-gray-300 text-gray-500 hover:border-primary hover:text-primary transition-colors" data-filter="3">3 Recámaras</button>
          <button class="filter-btn px-4 py-2 text-xs font-medium border border-gray-300 text-gray-500 hover:border-primary hover:text-primary transition-colors" data-filter="4">4 Recámaras</button>
        </div>

        <div class="overflow-x-auto fade-in">
          <table class="w-full text-left border-collapse" id="catalogo-table">
            <thead>
              <tr class="border-b-2 border-primary">
                <th class="py-3 px-4 text-xs font-bold text-dark uppercase tracking-wider">Prototipo</th>
                <th class="py-3 px-4 text-xs font-bold text-dark uppercase tracking-wider">Nivel</th>
                <th class="py-3 px-4 text-xs font-bold text-dark uppercase tracking-wider text-center">Recámaras</th>
                <th class="py-3 px-4 text-xs font-bold text-dark uppercase tracking-wider text-center">Baños</th>
                <th class="py-3 px-4 text-xs font-bold text-dark uppercase tracking-wider text-center">m² Interiores</th>
                <th class="py-3 px-4 text-xs font-bold text-dark uppercase tracking-wider text-center">Terraza</th>
                <th class="py-3 px-4 text-xs font-bold text-dark uppercase tracking-wider text-center">Roof Garden</th>
                <th class="py-3 px-4 text-xs font-bold text-dark uppercase tracking-wider text-center">m² Total</th>
                <th class="py-3 px-4 text-xs font-bold text-dark uppercase tracking-wider text-right">Precio</th>
                <th class="py-3 px-4 text-xs font-bold text-dark uppercase tracking-wider text-right">Mantenimiento</th>
              </tr>
            </thead>
            <tbody id="catalogo-body">
              {catalogoData.map((item) => (
                <tr class="border-b border-gray-200 hover:bg-primary/5 transition-colors catalogo-row" data-recamaras={item.recamaras}>
                  <td class="py-3 px-4 text-sm font-semibold text-dark">{item.prototipo}</td>
                  <td class="py-3 px-4">
                    <span class={`inline-block px-2 py-0.5 text-[10px] font-medium rounded-full ${
                      item.nivel === 'Roof Garden' ? 'bg-gold/20 text-gold' :
                      item.nivel === 'Planta Jardín' ? 'bg-green-100 text-green-700' :
                      'bg-blue-100 text-blue-700'
                    }`}>{item.nivel}</span>
                  </td>
                  <td class="py-3 px-4 text-sm text-gray-600 text-center">{item.recamaras}</td>
                  <td class="py-3 px-4 text-sm text-gray-600 text-center">{item.banos}{item.medioBano > 0 ? ` + ${item.medioBano}` : ''}</td>
                  <td class="py-3 px-4 text-sm text-gray-600 text-center">{item.m2Interiores} m²</td>
                  <td class="py-3 px-4 text-sm text-gray-600 text-center">{item.terraza > 0 ? `${item.terraza} m²` : '—'}</td>
                  <td class="py-3 px-4 text-sm text-gray-600 text-center">{item.roofGarden > 0 ? `${item.roofGarden} m²` : '—'}</td>
                  <td class="py-3 px-4 text-sm font-medium text-dark text-center">{item.m2Total} m²</td>
                  <td class="py-3 px-4 text-sm font-bold text-primary text-right">${item.precioLista.toLocaleString('es-MX')}</td>
                  <td class="py-3 px-4 text-sm text-gray-500 text-right">${item.costoMtto.toLocaleString('es-MX')}/mes</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="text-center text-gray-400 text-xs mt-6">Precios en pesos mexicanos. sujetos a cambio sin previo aviso.</p>
      </div>
    </section>

    <Amenities />

    <section class="py-14 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div class="fade-in order-2 md:order-1">
            <div class="overflow-hidden">
              <img src={`${base}/images/ubicacion.webp`} alt="Ubicación La Serena" class="w-full h-[350px] object-cover" loading="lazy" />
            </div>
          </div>
          <div class="fade-in order-1 md:order-2">
            <p class="text-gold text-sm tracking-[0.2em] uppercase mb-3">Ubicación Privilegiada</p>
            <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4">A 8 Minutos del patrimonio cultural de la humanidad</h2>
            <div class="w-14 h-0.5 bg-gold mb-6"></div>
            <p class="text-gray-500 text-sm mb-6">
              Carretera San Miguel - Celaya 41, Fracc. Villa de Los Frailes, 37790, San Miguel de Allende, Gto.
            </p>
            <a href="https://maps.google.com" target="_blank" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white px-5 py-2.5 text-xs tracking-wide transition-colors">
              Ver en Google Maps
            </a>
            <div class="mt-6 grid grid-cols-2 gap-x-6 gap-y-2">
              <p class="text-gray-500 text-xs">Centro Histórico</p>
              <p class="text-gray-500 text-xs">El Mirador</p>
              <p class="text-gray-500 text-xs">Museo Casa Allende</p>
              <p class="text-gray-500 text-xs">Centro Cultural La Aurora</p>
              <p class="text-gray-500 text-xs">Mercado de Artesanías</p>
              <p class="text-gray-500 text-xs">Teatro Ángela Peralta</p>
              <p class="text-gray-500 text-xs">Centro Cultural Ignacio Ramírez</p>
              <p class="text-gray-500 text-xs">Club de Golf Malanquín</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="contacto-la-serena" class="py-20 overlay-primary section-bg" style="background-image: url('${base}/images/background1.webp')">
      <div class="relative z-10 max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12">
          <div class="fade-in">
            <p class="text-gold text-sm tracking-[0.2em] uppercase mb-3">La Serena Residencial</p>
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Agenda tu Visita</h2>
            <div class="w-14 h-0.5 bg-gold mb-6"></div>
            <p class="text-white/70 mb-8 text-sm leading-relaxed">
              Descubre todo lo que La Serena Residencial tiene para ti. Nuestro equipo estará encantado de atenderte.
            </p>

            <div class="space-y-5">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-white/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gold" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-white/50 text-xs">WhatsApp</p>
                  <p class="text-white text-sm font-medium">+52 415 145 7780 / +52 415 177 5033</p>
                </div>
              </div>

              <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-white/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-white/50 text-xs">Oficina</p>
                  <p class="text-white text-sm font-medium">+52 415 148 4616</p>
                </div>
              </div>

              <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-white/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-white/50 text-xs">Dirección</p>
                  <p class="text-white text-sm font-medium">Carretera San Miguel - Celaya 41</p>
                </div>
              </div>

              <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-white/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-white/50 text-xs">Email</p>
                  <p class="text-white text-sm font-medium">laura@badi108realestate.com</p>
                  <p class="text-white text-sm font-medium">alejandro@badi108realestate.com</p>
                </div>
              </div>
            </div>
          </div>

          <div class="fade-in">
            <form class="bg-white p-7">
              <div class="mb-4">
                <label class="block text-xs font-medium text-dark mb-1.5">Nombre Completo</label>
                <input type="text" class="w-full px-3 py-2.5 border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm" placeholder="Tu nombre" />
