<script>
  const video = document.getElementById('promo-video');
  const btn = document.getElementById('unmute-btn');
  const iconMuted = document.getElementById('icon-muted');
  const iconUnmuted = document.getElementById('icon-unmuted');

  if (video && btn) {
    btn.addEventListener('click', () => {
      video.muted = !video.muted;
      iconMuted.classList.toggle('hidden');
      iconUnmuted.classList.toggle('hidden');
    });
  }

  const filterBtns = document.querySelectorAll('.filter-btn');
  const rows = document.querySelectorAll('.catalogo-row');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('active', 'bg-primary', 'text-white');
        b.classList.add('border-gray-300', 'text-gray-500');
      });
      btn.classList.add('active', 'bg-primary', 'text-white');
      btn.classList.remove('border-gray-300', 'text-gray-500');

      const filter = btn.getAttribute('data-filter');
      rows.forEach((row) => {
        if (filter === 'all' || row.getAttribute('data-recamaras') === filter) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });
  });
</script>
