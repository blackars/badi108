---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PropertyCard from '../components/tokko/PropertyCard.astro';
import { getTokkoRentaLive, getSpecs } from '../lib/tokko';

const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');

// Tokko live dinámico TTL 90-120s (Cloud Run minInstances 0, costo mínimo)
let tokkoRenta: any[] = [];
try {
  const live = await getTokkoRentaLive();
  tokkoRenta = live.map((n) => ({
    ...n,
    specs: getSpecs(n),
    href: `${BASE}/rentas/tokko/${n.slug}`,
  }));
} catch (e) {
  console.warn('Tokko live fetch falló, rentas:', e);
}
---

<Layout title="Rentas | BADI 108 Real Estate">
  <Navbar />
  <main>
    <section class="relative h-[40vh] min-h-[300px] overflow-hidden">
      <div class="absolute inset-0">
        <img src={`${BASE}/images/hero-plaza.webp`} alt="Rentas" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-primary/80 to-primary/90"></div>
      </div>
      <div class="relative z-10 h-full flex flex-col items-center justify-center text-center px-6">
        <p class="text-gold text-xs tracking-[0.3em] uppercase mb-3 font-light">Propiedades en Renta</p>
        <h1 class="text-4xl md:text-6xl font-bold text-white">Vive San Miguel de Allende </h1>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-14 fade-in">
          <p class="text-gold text-sm tracking-[0.2em] uppercase mb-3">Encuentra el lugar ideal para vivir en San Miguel de Allende</p>
          <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4">Propiedades en Renta</h2>
          <div class="w-14 h-0.5 bg-gold mx-auto mb-6"></div>
          <p class="text-gray-500 max-w-xl mx-auto text-md leading-relaxed">
Encontrar la propiedad adecuada es mucho más que elegir una casa o un departamento; es encontrar el espacio donde comenzar una nueva etapa con tranquilidad, comodidad y la confianza de haber tomado la mejor decisión.
          </p>
          <p class="text-gray-500 max-w-xl mx-auto text-md leading-relaxed">
En BADI 108 Real Estate te acompañamos a encontrar la opción que mejor se adapte a tu estilo de vida. Descubre nuestra selección de propiedades en renta y recibe una asesoría personalizada durante todo el proceso, para que disfrutes una experiencia segura, transparente y sin complicaciones.          </p>
        </div>

        {tokkoRenta.length > 0 ? (
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {tokkoRenta.map((p) => (
              <PropertyCard
                id={p.id}
                title={p.title}
                location={p.locationShort}
                price={p.priceFormatted}
                typeName={p.typeName}
                operationLabel={p.operationLabel}
                cover={p.cover}
                specs={p.specs}
                href={p.href}
              />
            ))}
          </div>
        ) : (
          <div class="text-center py-16 border border-gray-200 bg-gray-50">
            <p class="text-gray-400 text-sm">No hay propiedades en renta disponibles por el momento.</p>
            <p class="text-gray-400 text-xs mt-2">Las propiedades sincronizadas desde Tokko aparecerán aquí automáticamente.</p>
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
