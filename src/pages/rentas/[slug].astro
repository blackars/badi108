---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import fs from 'fs';
import path from 'path';

const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');

export async function getStaticPaths() {
  const IMAGE_DIR = path.join(process.cwd(), 'public', 'images', 'rentas');

  function getMedia(folder) {
    const dir = path.join(IMAGE_DIR, folder);
    if (!fs.existsSync(dir)) return [];
    return fs.readdirSync(dir)
      .filter(f => /\.(jpg|jpeg|png|webp|webm|mp4)$/i.test(f))
      .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
  }

  const rentals = [
    { id: 'relox-08b', name: 'Relox 08-B', location: 'La Serena Residencial, SMA', type: 'Departamento', price: 'Consultar', detailBar: '86 m² | 2 Recámaras | 2 Baños | Terraza | Jardín | Planta Jardín', specs: ['2 Recámaras', '2 Baños', 'Terraza', 'Jardín', 'Cocina Equipada', 'Área de Lavado', '86 m²'], description: 'Disfruta una estancia inolvidable en este hermoso departamento en planta jardín, completamente amueblado y equipado para brindarte el máximo confort, combinado con el servicio y la atención de un hotel de prestigio.\n\nCuenta con 2 recámaras, 2 baños completos, sala, comedor, cocina totalmente equipada, área de lavado y una agradable terraza con jardín, ideal para relajarte o compartir momentos especiales con familia y amigos.\n\nUbicado dentro de La Serena Residencial, un exclusivo desarrollo inspirado en la esencia de San Miguel de Allende, con arquitectura colonial, calles pintorescas y un ambiente único.\n\nDurante tu estancia podrás disfrutar de más de 21 amenidades premium, entre ellas albercas, spa, gimnasio, restaurante con servicio a la habitación (Room Service), Sunset Bar con una espectacular vista a la presa y atención con administración hotelera.\n\nLa Serena también cuenta con espacios para la realización de eventos privados como bodas, XV años, cumpleaños y retiros, convirtiéndolo en el lugar ideal para vivir una experiencia inolvidable en el corazón de México.' },
    { id: 'relox-07c-aldama', name: 'Relox 07-C Aldama', location: 'La Serena Residencial, SMA', type: 'Departamento', price: 'Consultar', detailBar: '105 m² | 2 Recámaras | 2 Baños | Terraza | Cocina Equipada | Planta Intermedia', specs: ['2 Recámaras', '2 Baños', 'Terraza', 'Cocina Equipada', '105 m²'], description: 'Disfruta una estancia excepcional en este elegante departamento Modelo Aldama, con 105 m² de espacios cuidadosamente diseñados para ofrecer comodidad, funcionalidad y una experiencia de hospedaje con el confort y la atención de un hotel de prestigio.\n\nUbicado en planta intermedia, cuenta con una agradable terraza, 2 amplias recámaras con closets de excelente tamaño, 2 baños completos, sala, comedor, cocina totalmente equipada y centro de lavado, brindando todo lo necesario para una estancia cómoda y placentera.\n\nEl departamento cuenta con todos los servicios contratados y listos para su uso, por lo que no tendrás que realizar ningún trámite; únicamente el consumo de los mismos se cubre de manera independiente a la renta. Además, ya dispone de aires acondicionados adquiridos, listos para su próxima instalación, ofreciendo un mayor nivel de confort.\n\nGracias a su excelente ubicación, muy cercano a la Casa Club, podrás disfrutar de las más de 21 amenidades premium de La Serena Residencial, entre ellas albercas, spa, gimnasio, restaurante con servicio a la habitación (Room Service), Sunset Bar con una espectacular vista a la presa y administración hotelera.' },
    { id: 'relox-07a-aldama-pj', name: 'Relox 07-A Aldama P-J', location: 'La Serena Residencial, SMA', type: 'Departamento', price: 'Consultar', detailBar: '105 m² | 2 Recámaras | 2 Baños | Terraza | Jardín Privado | Planta Jardín', specs: ['2 Recámaras', '2 Baños', 'Terraza', 'Jardín', 'Cocina Equipada', '105 m²'], description: 'Vive una estancia excepcional en este elegante Modelo Aldama Planta Jardín, con 105 m² de espacios cuidadosamente diseñados para ofrecer comodidad, funcionalidad y una experiencia de hospedaje con el confort y la atención de un hotel de prestigio.\n\nCuenta con 2 amplias recámaras con closets de excelente tamaño, 2 baños completos, sala, comedor, cocina totalmente equipada y centro de lavado, brindando todo lo necesario para una estancia cómoda y placentera.\n\nUno de sus mayores atractivos es su amplia terraza equipada con televisión, ideal para disfrutar eventos deportivos, películas o tu programación favorita mientras compartes momentos inolvidables con familia y amigos. Además, dispone de un generoso jardín privado, rodeado por un hermoso árbol que proporciona sombra natural y una elegante jardinera que crea un ambiente de tranquilidad y armonía, perfecto para relajarse al aire libre.\n\nUbicado dentro de La Serena Residencial y muy cerca de la Casa Club, tendrás acceso a más de 21 amenidades premium, entre ellas albercas, spa, gimnasio, restaurante con servicio a la habitación (Room Service), Sunset Bar con una espectacular vista a la presa y administración hotelera.' },
    { id: 'relox-10a-recreo', name: 'Relox 10-A Recreo', location: 'La Serena Residencial, SMA', type: 'Departamento', price: 'Consultar', detailBar: '86 m² | 2 Recámaras | 2 Baños | Terraza | Jardín Privado | Frente a Casa Club', specs: ['2 Recámaras', '2 Baños', 'Terraza', 'Jardín', 'Cocina Equipada', 'Asador', '86 m²'], description: 'Descubre el equilibrio perfecto entre comodidad, exclusividad y el encanto de San Miguel de Allende en este hermoso Modelo Recreo Planta Jardín, completamente amueblado y equipado para ofrecer una experiencia de hospedaje con el confort y la atención de un hotel de prestigio.\n\nSu ubicación privilegiada en esquina, con vista al jardín principal y frente a la Casa Club, permite disfrutar de las mejores amenidades del residencial a solo unos pasos.\n\nCaracterísticas:\n86 m² de construcción. 2 amplias recámaras con closets de excelente tamaño. 2 baños completos. Sala y comedor. Cocina totalmente equipada. Centro de lavado. Todos los servicios contratados.\n\nLa amplia terraza, equipada con cómoda sala exterior y asador, es el lugar ideal para disfrutar una carne asada, convivir con familia y amigos o simplemente relajarte al aire libre.\n\nSu jardín privado brinda un ambiente acogedor y es perfecto para celebrar un cumpleaños, organizar reuniones familiares o disfrutar de una tarde rodeado de tranquilidad.\n\nComo huésped de La Serena Residencial, tendrás acceso a más de 21 amenidades premium, entre ellas albercas, spa, gimnasio, restaurante con servicio a la habitación (Room Service), Sunset Bar con vista a la presa, áreas verdes, seguridad y administración hotelera.' },
    { id: 'insurgentes-10d', name: 'Insurgentes 10-D', location: 'La Serena Residencial, SMA', type: 'Departamento', price: 'Consultar', detailBar: '86 m² | 2 Recámaras | 2 Baños | Terraza | Vista a Canchas de Tenis y Pádel', specs: ['2 Recámaras', '2 Baños', 'Terraza', 'Cocina Equipada', '86 m²'], description: 'Descubre la combinación perfecta entre comodidad, exclusividad y una ubicación privilegiada en este Modelo Recreo Planta Intermedia, completamente amueblado y equipado para brindarte una experiencia de hospedaje con el confort y la atención de un hotel de prestigio.\n\nSu excelente ubicación ofrece una hermosa vista a las canchas de tenis y pádel, además de contar con acceso directo a la segunda sección de áreas verdes de La Serena Residencial, donde podrás disfrutar de la segunda alberca, fogateros, anfiteatro y amplios jardines.\n\nCaracterísticas:\n86 m² de construcción. 2 amplias recámaras con closets de excelente tamaño. 2 baños completos. Sala y comedor. Cocina totalmente equipada. Centro de lavado. Terraza privada con agradables vistas. Todos los servicios contratados.\n\nDesde su terraza podrás disfrutar de un entorno tranquilo y lleno de áreas verdes, con acceso inmediato a algunos de los espacios recreativos más atractivos del residencial.\n\nComo huésped de La Serena Residencial, tendrás acceso a más de 21 amenidades premium, entre ellas albercas, spa, gimnasio, restaurante con servicio a la habitación (Room Service), Sunset Bar con una espectacular vista a la presa, canchas de tenis y pádel, áreas verdes, seguridad 24/7 y administración hotelera.' },
    { id: 'relox-17c-aldama', name: 'Relox 17-C Aldama', location: 'La Serena Residencial, SMA', type: 'Departamento', price: 'Consultar', detailBar: '105 m² | 2 Recámaras | 2 Baños | Terraza | Cocina Integral | Departamento Nuevo y Recién Remodelado', specs: ['2 Recámaras', '2 Baños', 'Terraza', 'Cocina Integral', '105 m²'], description: 'Descubre este exclusivo Modelo Aldama Planta Intermedia, un departamento de 105 m² que destaca por su diseño, amplitud y excelente ubicación dentro de La Serena Residencial. Se entrega sin muebles, ofreciéndote la libertad de personalizar cada espacio de acuerdo con tu estilo y necesidades.\n\nEl departamento es completamente nuevo y recién remodelado, convirtiéndose en una propiedad única dentro del residencial. Se realizaron mejoras de alta calidad, incluyendo piso en todo el departamento, elegantes accesorios de baño y luminarias de excelente gusto, que aportan un ambiente moderno, cálido y sofisticado.\n\nCaracterísticas:\n105 m² de construcción. 2 amplias recámaras con closets de excelente tamaño. 2 baños completos. Sala y comedor. Cocina integral. Terraza privada. Opción de incluir refrigerador y centro de lavado. Todos los servicios contratados.\n\nCada detalle ha sido cuidadosamente seleccionado para ofrecer una imagen elegante y contemporánea, ideal para quienes buscan estrenar un departamento en uno de los residenciales más exclusivos de San Miguel de Allende.\n\nComo residente de La Serena Residencial, disfrutarás de más de 21 amenidades premium, entre ellas albercas, spa, gimnasio, restaurante con servicio a la habitación (Room Service), Sunset Bar con vista a la presa, canchas deportivas, amplias áreas verdes, seguridad 24/7 y administración hotelera.' },
    { id: 'hidalgo-08a-recreo-pj', name: 'Hidalgo 08-A Recreo P-J', location: 'La Serena Residencial, SMA', type: 'Departamento', price: 'Consultar', detailBar: '86 m² | 2 Recámaras | 2 Baños | Terraza | Jardín Privado | Amueblado y Equipado', specs: ['2 Recámaras', '2 Baños', 'Terraza', 'Jardín', 'Cocina Equipada', '86 m²'], description: 'Disfruta de la comodidad y exclusividad de este Modelo Recreo Planta Jardín, un departamento de 86 m² completamente amueblado y equipado, diseñado para ofrecer una experiencia de hospedaje con el confort y la atención de un hotel de prestigio.\n\nSu distribución funcional incluye 2 amplias recámaras con closets de excelente tamaño, 2 baños completos, sala, comedor, cocina totalmente equipada, centro de lavado y una agradable terraza que se integra perfectamente con el jardín privado.\n\nUno de sus principales atractivos es su amplio jardín con piso, ideal para colocar mesas y mobiliario exterior, perfecto para organizar reuniones familiares, celebrar cumpleaños o disfrutar de una agradable comida al aire libre. Al fondo se encuentra una hermosa jardinera, que aporta privacidad y un entorno natural.\n\nCaracterísticas:\n86 m² de construcción. 2 amplias recámaras. 2 baños completos. Sala y comedor. Cocina totalmente equipada. Centro de lavado. Terraza y jardín privado con piso. Jardinera decorativa al fondo. Todos los servicios contratados.\n\nComo huésped de La Serena Residencial, tendrás acceso a más de 21 amenidades premium, entre ellas albercas, spa, gimnasio, restaurante con servicio a la habitación (Room Service), Sunset Bar con vista a la presa, canchas deportivas, amplias áreas verdes, seguridad 24/7 y administración hotelera.' },
    { id: 'hidalgo-02c', name: 'Hidalgo 02-C', location: 'La Serena Residencial, SMA', type: 'Departamento', price: 'Consultar', detailBar: '86 m² | 2 Recámaras | 2 Baños | Terraza | Amueblado y Equipado', specs: ['2 Recámaras', '2 Baños', 'Terraza', 'Cocina Equipada', '86 m²'], description: 'Descubre este Modelo Recreo Planta Intermedia, un departamento de 86 m² completamente amueblado y equipado, diseñado para brindar comodidad, funcionalidad y una experiencia de hospedaje con el confort y la atención de un hotel de prestigio.\n\nSu distribución ofrece 2 amplias recámaras con closets de excelente tamaño, 2 baños completos, sala, comedor, cocina totalmente equipada, centro de lavado y una agradable terraza privada, el espacio perfecto para disfrutar un café por la mañana, relajarte al atardecer o compartir momentos especiales con familia y amigos.\n\nCaracterísticas:\n86 m² de construcción. 2 amplias recámaras. 2 baños completos. Sala y comedor. Cocina totalmente equipada. Centro de lavado. Terraza privada. Completamente amueblado y equipado. Todos los servicios contratados.\n\nComo huésped de La Serena Residencial, disfrutarás de más de 21 amenidades premium, entre ellas albercas, spa, gimnasio, restaurante con servicio a la habitación (Room Service), Sunset Bar con espectacular vista a la presa, canchas de tenis y pádel, amplias áreas verdes, seguridad 24/7 y administración hotelera.' },
    { id: 'relox-28d-recreo', name: 'Relox 28-D Recreo', location: 'La Serena Residencial, SMA', type: 'Departamento', price: 'Consultar', detailBar: '86 m² | 2 Recámaras | 2 Baños | Terraza | Amueblado y Equipado', specs: ['2 Recámaras', '2 Baños', 'Terraza', 'Cocina Equipada', '86 m²'], description: 'Descubre este Modelo Recreo Planta Intermedia, un departamento de 86 m² completamente amueblado y equipado, diseñado para brindar comodidad, funcionalidad y una experiencia de hospedaje con el confort y la atención de un hotel de prestigio.\n\nSu distribución ofrece 2 amplias recámaras con closets de excelente tamaño, 2 baños completos, sala, comedor, cocina totalmente equipada, centro de lavado y una agradable terraza privada, el espacio perfecto para disfrutar un café por la mañana, relajarte al atardecer o compartir momentos especiales con familia y amigos.\n\nCaracterísticas:\n86 m² de construcción. 2 amplias recámaras. 2 baños completos. Sala y comedor. Cocina totalmente equipada. Centro de lavado. Terraza privada. Completamente amueblado y equipado. Todos los servicios contratados.\n\nComo huésped de La Serena Residencial, disfrutarás de más de 21 amenidades premium, entre ellas albercas, spa, gimnasio, restaurante con servicio a la habitación (Room Service), Sunset Bar con espectacular vista a la presa, canchas de tenis y pádel, amplias áreas verdes, seguridad 24/7 y administración hotelera.' },
    { id: 'relox-02c-recreo', name: 'Relox 02-C Recreo', location: 'La Serena Residencial, SMA', type: 'Departamento', price: 'Consultar', detailBar: '86 m² | 2 Recámaras | 2 Baños | Terraza | Amueblado y Equipado', specs: ['2 Recámaras', '2 Baños', 'Terraza', 'Cocina Equipada', '86 m²'], description: 'Descubre este Modelo Recreo Planta Intermedia, un departamento de 86 m² completamente amueblado y equipado, diseñado para brindar comodidad, funcionalidad y una experiencia de hospedaje con el confort y la atención de un hotel de prestigio.\n\nSu distribución ofrece 2 amplias recámaras con closets de excelente tamaño, 2 baños completos, sala, comedor, cocina totalmente equipada, centro de lavado y una agradable terraza privada, el espacio perfecto para disfrutar un café por la mañana, relajarte al atardecer o compartir momentos especiales con familia y amigos.\n\nCaracterísticas:\n86 m² de construcción. 2 amplias recámaras. 2 baños completos. Sala y comedor. Cocina totalmente equipada. Centro de lavado. Terraza privada. Completamente amueblado y equipado. Todos los servicios contratados.\n\nComo huésped de La Serena Residencial, disfrutarás de más de 21 amenidades premium, entre ellas albercas, spa, gimnasio, restaurante con servicio a la habitación (Room Service), Sunset Bar con espectacular vista a la presa, canchas de tenis y pádel, amplias áreas verdes, seguridad 24/7 y administración hotelera.' },
  ];

  return rentals.map(r => ({
    params: { slug: r.id },
    props: { ...r, media: getMedia(r.id) }
  }));
}

const { id, name, location, type, price, detailBar, specs, description, media } = Astro.props;
const propertyName = typeof name === 'string' && name.trim() ? name : id;
const mediaUrl = (file) => `${BASE}/images/rentas/${id}/${encodeURIComponent(file)}`;
const isVideo = (file) => /\.webm$/i.test(file);
---

<Layout title={`${propertyName} | Rentas | BADI 108`}>
  <Navbar />
  <main>
    <div class="bg-black relative" style="height: 70vh; min-height: 400px;">
      <div class="w-full h-full flex items-center justify-center p-4">
        {media.length > 0 ? (
          isVideo(media[0]) ? (
            <video id="gallery-video" class="max-w-full max-h-full object-contain select-none" src={mediaUrl(media[0])} autoplay muted loop playsinline></video>
          ) : (
            <img id="gallery-img" class="max-w-full max-h-full object-contain select-none" src={mediaUrl(media[0])} alt={name} />
          )
        ) : (
          <div class="text-center text-white/40">
            <svg class="w-20 h-20 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <p class="text-sm">Sin medios disponibles</p>
          </div>
        )}
      </div>

      {media.length > 1 && (
        <>
          <button id="prev-btn" class="absolute left-3 top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-colors rounded-full">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button id="next-btn" class="absolute right-3 top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-colors rounded-full">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
          <div id="counter" class="absolute bottom-4 left-1/2 -translate-x-1/2 z-10 bg-black/50 text-white text-xs px-3 py-1 rounded">1 / {media.length}</div>
        </>
      )}
    </div>

    <section class="py-12 bg-white">
      <div class="max-w-4xl mx-auto px-6">
        <div class="mb-8">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-[10px] bg-gold text-white px-3 py-1 font-semibold uppercase tracking-wider">{type}</span>
            <h1 class="text-2xl md:text-3xl font-bold text-dark">{propertyName}</h1>
          </div>
          <p class="text-gray-400 text-sm">{location}</p>
          <p class="text-gold text-lg font-bold mt-2">{price}</p>
        </div>

        <div class="mb-8 bg-gray-50 border border-gray-200 px-5 py-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-600">
          {detailBar.split('|').map((item) => (
            <span>{item.trim()}</span>
          )).reduce((prev, curr, i) => i === 0 ? [curr] : [prev, <span class="text-gold">|</span>, curr], [])}
        </div>

        <div class="mb-10">
          <h2 class="text-lg font-bold text-dark mb-3 border-b border-gray-100 pb-2">Descripción</h2>
          <p class="text-gray-500 text-sm leading-relaxed">{description}</p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Amenidades</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-y-4 gap-x-3">
            {specs.includes('Baños') && (
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 8h16M4 8v6a2 2 0 002 2h12a2 2 0 002-2V8M4 8V6a2 2 0 012-2h12a2 2 0 012 2v2"/>
                </svg>
                <span class="text-sm text-gray-600">{specs.find(s => s.includes('Baños'))}</span>
              </div>
            )}
            {specs.includes('Recámaras') && (
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="8" width="16" height="10" rx="1"/><line x1="4" y1="12" x2="20" y2="12"/><rect x="7" y="10" width="4" height="2" rx="0.5"/>
                </svg>
                <span class="text-sm text-gray-600">{specs.find(s => s.includes('Recámaras'))}</span>
              </div>
            )}
            {specs.some(s => /estacionamiento|parqueo|garaje/i.test(s)) && (
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 17v2a1 1 0 001 1h2a1 1 0 001-1v-1h6v1a1 1 0 001 1h2a1 1 0 001-1v-2M5 17l2-7h10l2 7M5 17h14"/><circle cx="7" cy="15" r="1.5"/><circle cx="17" cy="15" r="1.5"/>
                </svg>
                <span class="text-sm text-gray-600">Estacionamiento</span>
              </div>
            )}
            {specs.some(s => /terraza|patio/i.test(s)) && (
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
                </svg>
                <span class="text-sm text-gray-600">{specs.find(s => /terraza|patio/i.test(s))}</span>
              </div>
            )}
            {specs.some(s => /pérgola|pergola/i.test(s)) && (
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 12c0-5 4-10 9-10s9 5 9 10M12 2v18M8 22h8"/>
                </svg>
                <span class="text-sm text-gray-600">Pérgola</span>
              </div>
            )}
            {specs.some(s => /balcón|balcon/i.test(s)) && (
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="10" width="20" height="12" rx="1"/><line x1="6" y1="10" x2="6" y2="6"/><line x1="18" y1="10" x2="18" y2="6"/><line x1="14" y1="10" x2="14" y2="6"/><line x1="10" y1="10" x2="10" y2="6"/>
                </svg>
                <span class="text-sm text-gray-600">Balcón</span>
              </div>
            )}
            {specs.some(s => /cocina/i.test(s)) && (
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 14h18v3a3 3 0 01-3 3H6a3 3 0 01-3-3v-3zM5 10V6a2 2 0 012-2h10a2 2 0 012 2v4"/><line x1="9" y1="2" x2="9" y2="4"/><line x1="15" y1="2" x2="15" y2="4"/>
                </svg>
                <span class="text-sm text-gray-600">{specs.find(s => /cocina/i.test(s))}</span>
              </div>
            )}
            {specs.some(s => /sala|comedor/i.test(s)) && (
              <div class="flex items-center gap-2">
