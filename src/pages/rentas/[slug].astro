                <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22V12M12 12l-5 4M12 12l5 4M12 4L7 9M12 4l5 5"/><path d="M12 4a5 5 0 00-5 5h10a5 5 0 00-5-5z"/>
                </svg>
                <span class="text-sm text-gray-600">Roof Garden</span>
