            {!specs.some(s => /baños|recámaras|estacionamiento|terraza|pérgola|balcón|cocina|comedor|lavadero|roof garden|alberca|jardín|cisterna|patio|sala|lavado|pool|garaje|parqueo/i.test(s)) && specs.map(spec => (
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="text-sm text-gray-600">{spec}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script define:vars={{ media, slug: id, base: BASE }}>
  if (media.length > 1) {
    const container = document.querySelector('.bg-black .flex.items-center.justify-center');
    const counter = document.getElementById('counter');
    let current = 0;

    function isVideo(f) { return /\.webm$/i.test(f); }

    function render() {
      const filename = encodeURIComponent(media[current]);
      const url = `${base}/images/rentas/${slug}/${filename}`;
      const existingImg = document.getElementById('gallery-img');
      const existingVid = document.getElementById('gallery-video');

      if (isVideo(media[current])) {
        if (existingImg) existingImg.remove();
        let vid = existingVid;
        if (!vid) {
          vid = document.createElement('video');
          vid.id = 'gallery-video';
          vid.className = 'max-w-full max-h-full object-contain select-none';
          vid.autoplay = true;
          vid.muted = true;
          vid.loop = true;
          vid.playsInline = true;
          container.prepend(vid);
        }
        vid.src = url;
        vid.play().catch(() => {});
      } else {
        if (existingVid) existingVid.remove();
        let img = existingImg;
        if (!img) {
          img = document.createElement('img');
          img.id = 'gallery-img';
          img.className = 'max-w-full max-h-full object-contain select-none';
          img.alt = slug;
          container.prepend(img);
        }
        img.src = url;
      }
      counter.textContent = `${current + 1} / ${media.length}`;
    }

    document.getElementById('prev-btn').addEventListener('click', () => {
      current = (current - 1 + media.length) % media.length;
      render();
    });

    document.getElementById('next-btn').addEventListener('click', () => {
      current = (current + 1) % media.length;
      render();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        current = (current - 1 + media.length) % media.length;
        render();
      }
      if (e.key === 'ArrowRight') {
        current = (current + 1) % media.length;
        render();
      }
    });
  }
</script>
